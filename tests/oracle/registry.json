  "normalize": {
    "strip_patterns": [
      "Workspace: .*\\nGit branch: .*\\nStatus: .*\\n",
      "Recent commits:\\n.*\\n",
      "033e1c27f7.*\\n",
      "da16ca2fb3.*\\n",
      "044c90d1ac.*\\n",
      "b556892c9a.*\\n",
      "ffa3fabfef.*\\n",
      "\"/home/[^\"]*/slermes\""
    ],
    "strip_fields": [
      "root",
      "branch",
      "status",
      "recent_commits"
    ]
  }
