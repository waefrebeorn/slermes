{
  "version": 1,
  "description": "Agnostic oracle registry — maps port names to their harness/oracle/fixture trio. The runner iterates this file instead of requiring per-module shell scripts.",
  "ports": {
    "account_usage": {
      "harness": "tests/t_port_account_usage.c",
      "oracle": "tests/sta_oracle_account_usage.py",
      "fixtures": "tests/oracle/fixtures/account_usage"
    },
    "coding_context": {
      "harness": "tests/t_port_coding_context.c",
      "oracle": "tests/sta_oracle_coding_context.py",
      "fixtures": "tests/oracle/fixtures/coding_context"
    }
  },
  "normalize": {
    "strip_patterns": [
      "Workspace: .*\\nGit branch: .*\\nStatus: .*\\n",
      "Recent commits:\\n.*\\n",
      "033e1c27f7.*\\n",
      "da16ca2fb3.*\\n",
      "044c90d1ac.*\\n",
      "b556892c9a.*\\n",
      "ffa3fabfef.*\\n"
    ],
    "strip_fields": [
      "root",
      "branch",
      "status",
      "recent_commits"
    ]
  }
}