# Fixture for the PURE skill-trust helpers (tests/t_port_skills_guard.c).
# One op per line:
#   trust <source>            _resolve_trust_level
#   verdict <severity> <findings>   _determine_verdict  (sev: 3=critical,2=high,1=medium,0=low)
#
# _resolve_trust_level normalizes skills-sh/ skills.sh/ skils-sh/ skils.sh/
# prefixes, maps "official" -> builtin, and checks TRUSTED_REPOS exact or
# "trusted/" prefix; anything else -> community.

# === trust level resolution ===
trust builtin
trust trusted
trust agent-created
trust community
trust official
trust openai/skills
trust anthropics/skills
trust huggingface/skills
trust NVIDIA/skills
trust openai/skills/sub/skill
trust skills-sh/openai/skills
trust skills.sh/anthropics/skills
trust skils-sh/huggingface/skills
trust skils.sh/NVIDIA/skills
trust random/community-repo
trust some-unknown-source
trust skills-sh/something-else

# === verdict from severity ===
verdict 3 1
verdict 3 0
verdict 2 5
verdict 2 0
verdict 1 3
verdict 1 0
verdict 0 0
verdict 0 10
