  {"op": "parse_existing_memory_entries", "arg": "first entry\n\n§\n\nsecond entry\n\n§\n\nthird entry"},
  {"op": "parse_existing_memory_entries", "arg": ""},
  {"op": "merge_entries", "arg": {"existing": [], "incoming": ["hello world", "Hello World", "third entry"], "limit": 1000}},
  {"op": "merge_entries", "arg": {"existing": ["old entry"], "incoming": ["old entry", "new entry"], "limit": 1000}},
  {"op": "merge_entries", "arg": {"existing": [], "incoming": ["short"], "limit": 3}}
