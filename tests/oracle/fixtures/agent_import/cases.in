[
  {"op": "normalize_text", "arg": "Hello   World  Foo"},
  {"op": "normalize_text", "arg": "  Leading And Trailing  "},
  {"op": "normalize_text", "arg": "MixedCase TEXT"},
  {"op": "normalize_text", "arg": ""},
  {"op": "normalize_text", "arg": "\t\n whitespace \t\n"},
  {"op": "is_secret_key", "arg": "GITHUB_TOKEN"},
  {"op": "is_secret_key", "arg": "MY_API_KEY"},
  {"op": "is_secret_key", "arg": "HOST"},
  {"op": "is_secret_key", "arg": "PORT"},
  {"op": "claude_rule_to_command_pattern", "arg": "Bash(npm run build)"},
  {"op": "claude_rule_to_command_pattern", "arg": "Bash(npm run test:*)"},
  {"op": "claude_rule_to_command_pattern", "arg": "Bash(git diff *)"},
  {"op": "claude_rule_to_command_pattern", "arg": "Bash"},
  {"op": "claude_rule_to_command_pattern", "arg": "Read(~/.zshrc)"},
  {"op": "claude_rule_to_command_pattern", "arg": ""},
  {"op": "extract_markdown_entries", "arg": "# Global instructions\n\n## Style\n- Always use type hints\n- Prefer pathlib over os.path\n\nRun the linter before committing.\n"},
  {"op": "extract_markdown_entries", "arg": "# Codex rules\n\n- Never force-push to main\n- Keep commits atomic\n"},
  {"op": "extract_markdown_entries", "arg": "```bash\nkubectl -n ingress rollout restart deploy/nginx\n```\n\n| Severity | Contact |\n| SEV1 | on-call |\n\nNever page for SEV3.\n"},
  {"op": "sanitize_mcp_env", "arg": "{\"API_TOKEN\": \"x\", \"HOST\": \"h\", \"MY_KEY\": \"k\"}"},
  {"op": "sanitize_mcp_env", "arg": "{\"GITHUB_TOKEN\": \"secret\", \"GITHUB_HOST\": \"github.example.com\"}"},
  {"op": "parse_existing_memory_entries", "arg": "first entry\n\n§\n\nsecond entry\n\n§\n\nthird entry"},
  {"op": "parse_existing_memory_entries", "arg": ""},
  {"op": "merge_entries", "arg": {"existing": [], "incoming": ["hello world", "Hello World", "third entry"], "limit": 1000}},
  {"op": "merge_entries", "arg": {"existing": ["old entry"], "incoming": ["old entry", "new entry"], "limit": 1000}},
  {"op": "merge_entries", "arg": {"existing": [], "incoming": ["short"], "limit": 3}},
  {"op": "load_yaml_file", "arg": "provider: claude-3-5-sonnet-20241022\nmodel: anthropic\n"},
  {"op": "load_yaml_file", "arg": "command_allowlist:\n  - git diff *\n  - npm run build\n"},
  {"op": "load_yaml_file", "arg": "not: a: valid: yaml"},
  {"op": "load_yaml_file", "arg": ""},
  {"op": "dump_yaml_file", "arg": "{\"provider\": \"claude-3-5-sonnet-20241022\", \"model\": \"anthropic\"}"},
  {"op": "dump_yaml_file", "arg": "{\"command_allowlist\": [\"git diff *\", \"npm run build\"]}"},
  {"op": "default_source_dir", "arg": "claude-code"},
  {"op": "default_source_dir", "arg": "codex"},
  {"op": "detect_agents", "arg": "dummy"},
  {"op": "backup_memory_file", "arg": "@SBX@/memories/MEMORY.md"},
  {"op": "backup_memory_file", "arg": "@SBX@/nonexistent.md"},
