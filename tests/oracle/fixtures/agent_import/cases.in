  {"op": "claude_rule_to_command_pattern", "arg": ""},
  {"op": "extract_markdown_entries", "arg": "# Global instructions\n\n## Style\n- Always use type hints\n- Prefer pathlib over os.path\n\nRun the linter before committing.\n"},
  {"op": "extract_markdown_entries", "arg": "# Codex rules\n\n- Never force-push to main\n- Keep commits atomic\n"},
