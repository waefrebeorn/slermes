    "{\"items\":[{\"type\":\"message\",\"role\":\"user\",\"content\":\"task one\"},{\"type\":\"message\",\"role\":\"assistant\",\"content\":\"working\"},{\"type\":\"compaction\"}],\"budget\":500}",
