  "c_src": "harness.c",
  "c_fn": "wc_strip_ansi",
  "py_module": "tools/ansi_strip.py",
  "py_fn": "strip_ansi",
  "cflags": ["-I", "lib/libansi"],
  "extra_src": ["lib/libansi/ansi_strip.c"],
  "inputs": [
    "plain text only",
    "",
    "\u001b[31mred\u001b[0m",
    "\u001b[1;32mbold green\u001b[0m tail",
    "\u001b]0;window title\u0007after bel",
