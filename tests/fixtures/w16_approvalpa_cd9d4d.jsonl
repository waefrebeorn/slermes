{"func": "substitution_depth", "case": "empty command", "command": ""}
{"func": "substitution_depth", "case": "plain command", "command": "echo hello world"}
{"func": "substitution_depth", "case": "one substitution", "command": "echo $(foo)"}
{"func": "substitution_depth", "case": "nested substitution", "command": "echo $(a $(b))"}
{"func": "substitution_depth", "case": "single-quoted substitution is data", "command": "echo '$(foo)'"}
{"func": "substitution_depth", "case": "double-quoted substitution counts", "command": "echo \"$(foo)\""}
{"func": "substitution_depth", "case": "escaped dollar is literal", "command": "echo \\$(foo)"}
{"func": "substitution_depth", "case": "comment hides substitution", "command": "echo hi # $(foo)\n"}
{"func": "substitution_depth", "case": "hash glued to close paren still runs", "command": "echo $(echo a)# hi\n"}
{"func": "substitution_depth", "case": "arithmetic shift not heredoc", "command": "echo $((1<<2))"}
{"func": "substitution_depth", "case": "single quoted payload measured separately", "command": "echo 'x $(a) y'"}
{"func": "substitution_depth", "case": "paren balance inside frame", "command": "echo $(case x in (a) echo $(b);; esac)"}
{"func": "substitution_depth", "case": "quoted heredoc body skipped", "command": "cat <<'E'\n$(a)\nE\n$(b)\n"}
{"func": "substitution_depth", "case": "unquoted heredoc body counted", "command": "cat <<E\n$(a)\nE\n"}
