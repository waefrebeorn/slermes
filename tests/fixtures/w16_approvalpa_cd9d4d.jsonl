{"func": "dollar_paren_end", "case": "balanced", "command": "x$(a $(b))y", "start": 1}
{"func": "dollar_paren_end", "case": "unterminated", "command": "x$(a b", "start": 1}
{"func": "dollar_paren_end", "case": "quoted close is data", "command": "x$(echo \")\")z", "start": 1}
{"func": "backtick_end", "case": "simple", "command": "x`abc`y", "start": 1}
{"func": "backtick_end", "case": "escaped backtick", "command": "x`a\\`b`y", "start": 1}
{"func": "backtick_end", "case": "unterminated", "command": "x`abc", "start": 1}
{"func": "heredoc_bodies", "case": "quoted body span", "command": "cat <<'E'\nbody\nE\nrest", "newline": 9, "pending": [["E", false, true]]}
{"func": "heredoc_bodies", "case": "unquoted body no span", "command": "cat <<E\nbody\nE\nrest", "newline": 7, "pending": [["E", false, false]]}
{"func": "heredoc_bodies", "case": "strip tabs", "command": "x\n\tE\ny", "newline": 0, "pending": [["E", true, true]]}
{"func": "heredoc_bodies", "case": "continuation joins lines", "command": "cat <<E\na\\\nE\nE\nz", "newline": 7, "pending": [["E", false, false]]}
{"func": "heredoc_bodies", "case": "second pending delimiter", "command": "x\nA\ny\nB\nz", "newline": 0, "pending": [["A", false, true], ["B", false, true]]}
