{"func": "typed_summary_messages", "case": "gap-between-slices", "turns": [{"role": "user", "content": "a"}, {"role": "assistant", "content": "b"}, {"role": "user", "content": "c"}, {"role": "assistant", "content": "d"}], "records": ["[USER]: a", "[ASSISTANT]: b", "[USER]: c", "[ASSISTANT]: d"], "slices": [[0, ["[USER]: a"]], [3, ["[ASSISTANT]: d"]]], "real_user": [true, false, true, false]}
