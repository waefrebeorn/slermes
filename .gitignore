# ── Slermes .gitignore ────────────────────────────────────────────

# Build artifacts
slermes
slermes-static
slermes-tui
slermes-desktop-gui
slermes-fuzz
hermes-desktop

# Object files
*.o
*.obj
*.a

# Coverage
*.gcda
*.gcno
coverage_html/
coverage.info
coverage-filtered.info

# Auto-fetched dependencies (SQLite amalgamation)
lib/libdb/sqlite3.h
lib/libdb/sqlite3.c

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# AppImage tooling
appimagetool
AppDir/
Slermes-*.AppImage

# Build output
digest_output/

# Python (venv)
__pycache__/
*.pyc
.venv/
venv/

# Runtime-generated skill-scan caches (regenerated by oracle harness)
**/.scan-cache/
